{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hatchery/feeds/inspection",
  "title": "제품 내부 검사 (inspection)",
  "description": "지금 화면은 zone 유니언(shaft | bearing | winding)으로 부위를 찾는다(L1). 이 피드의 id가 그 역할을 맡도록 이관한다. 최대 3부위. 갱신: 검사 완료 이벤트. 장면: product.",
  "type": "object",
  "properties": {
    "name": {
      "description": "제품 이름",
      "type": "string",
      "minLength": 1
    },
    "serial": {
      "description": "제품 시리얼",
      "type": "string",
      "minLength": 1
    },
    "measurements": {
      "type": "array",
      "description": "측정 부위",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "도메인 코드(자연키), 목록 안에서 유일"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "표시 이름"
          },
          "nominal": {
            "description": "공칭값",
            "type": "number"
          },
          "actual": {
            "description": "실측값",
            "type": "number"
          },
          "tolerance": {
            "description": "허용 공차",
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "description": "단위",
            "type": "string",
            "minLength": 1
          },
          "decimals": {
            "description": "표시 소수 자릿수",
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "label",
          "nominal",
          "actual",
          "tolerance",
          "unit",
          "decimals"
        ]
      }
    }
  },
  "required": [
    "name",
    "serial",
    "measurements"
  ],
  "additionalProperties": true
}
