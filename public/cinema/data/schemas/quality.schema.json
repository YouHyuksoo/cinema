{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hatchery/feeds/quality",
  "title": "품질 SPC 측정 (quality)",
  "description": "targets가 있으면 배열 순서대로 순회하며 Xbar–R·히스토그램·Cpk를 동시에 표시. 생략하면 기존 단일 항목 사용. 빈 배열은 대상 없음. 다중 대상은 전체 스냅샷으로 갱신. 상위 측정값은 대표 항목 지표용. 갱신: 부분군 완성 시 이벤트, 또는 1~5분 폴링. 장면: spc, corners, unfold.",
  "type": "object",
  "properties": {
    "name": {
      "description": "측정 항목",
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "description": "단위",
      "type": "string",
      "minLength": 1
    },
    "nominal": {
      "description": "공칭값",
      "type": "number"
    },
    "lsl": {
      "description": "규격 하한",
      "type": "number"
    },
    "usl": {
      "description": "규격 상한",
      "type": "number"
    },
    "cpkTarget": {
      "description": "Cpk 목표",
      "type": "number",
      "minimum": 0
    },
    "subgroups": {
      "type": "array",
      "description": "부분군",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "도메인 코드(자연키), 목록 안에서 유일"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "표시 이름"
          },
          "values": {
            "description": "측정값",
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "label",
          "values"
        ]
      }
    },
    "targets": {
      "type": "array",
      "description": "SPC 분석 대상 (목록 순서대로 순회)",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "도메인 코드(자연키), 목록 안에서 유일"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "표시 이름"
          },
          "name": {
            "description": "측정 항목",
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "description": "단위",
            "type": "string",
            "minLength": 1
          },
          "nominal": {
            "description": "공칭값",
            "type": "number"
          },
          "lsl": {
            "description": "규격 하한",
            "type": "number"
          },
          "usl": {
            "description": "규격 상한",
            "type": "number"
          },
          "cpkTarget": {
            "description": "Cpk 목표",
            "type": "number",
            "minimum": 0
          },
          "subgroups": {
            "description": "해당 대상의 부분군 측정값",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 10
                }
              },
              "required": [
                "id",
                "values"
              ]
            }
          }
        },
        "required": [
          "id",
          "label",
          "name",
          "unit",
          "nominal",
          "lsl",
          "usl",
          "cpkTarget",
          "subgroups"
        ]
      }
    }
  },
  "required": [
    "name",
    "unit",
    "nominal",
    "lsl",
    "usl",
    "cpkTarget",
    "subgroups"
  ],
  "additionalProperties": true
}
