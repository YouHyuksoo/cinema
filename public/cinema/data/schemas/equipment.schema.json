{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hatchery/feeds/equipment",
  "title": "설비 마스터 · 상태 (equipment)",
  "description": "바이저 3D(라인 5개 × 설비 8대), 바이저 평면(리플로우 냉각), 설비 스캔, 기어, 정보 콘솔이 같은 설비 목록과 온도·냉각 값을 읽도록 이관한다. 배치 좌표는 화면이 순서(line·order)로 계산한다. 갱신: 5~10초 폴링 또는 상태 변경 푸시. 장면: visor, visorPan, scan, gears, console, cctv.",
  "type": "object",
  "properties": {
    "lines": {
      "description": "라인 수",
      "type": "number",
      "minimum": 1
    },
    "stations": {
      "type": "array",
      "description": "설비",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "도메인 코드(자연키), 목록 안에서 유일"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "표시 이름"
          },
          "english": {
            "description": "영문 이름",
            "type": "string",
            "minLength": 1
          },
          "line": {
            "description": "라인 번호",
            "type": "number",
            "minimum": 1
          },
          "order": {
            "description": "공정 순서",
            "type": "number",
            "minimum": 1
          },
          "kind": {
            "description": "설비 종류 · transport | production | quality | thermal",
            "type": "string",
            "minLength": 1
          },
          "status": {
            "description": "가동 상태 · running | idle | alarm | maintenance",
            "type": "string",
            "minLength": 1
          },
          "temperature": {
            "description": "공정 온도 · 단위 °C",
            "type": "number"
          },
          "fan": {
            "description": "냉각 팬 · 단위 %",
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "id",
          "label",
          "line",
          "order"
        ]
      }
    }
  },
  "required": [
    "lines",
    "stations"
  ],
  "additionalProperties": true
}
