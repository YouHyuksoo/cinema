# Server-only OpenAI configuration. Optional for visual demos.
# The AI settings screen (/cinema/ai) can store a provider/model/key in config/hatchery.sources.json instead;
# a saved key takes precedence, and these variables remain the fallback.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# TypeSafe: off keeps the existing command path; shadow evaluates without applying; on executes validated decisions.
# AI settings > TypeSafe / Jev saves server configuration; saved mode/model/key take precedence over these defaults.
TYPESAFE_API_KEY=
TYPESAFE_MODE=off
TYPESAFE_MODEL=jev-latest
# Comma-separated origins allowed to use server AI and admin APIs outside localhost.
# CINEMA_ALLOWED_ORIGINS=http://139.150.82.207:3010
